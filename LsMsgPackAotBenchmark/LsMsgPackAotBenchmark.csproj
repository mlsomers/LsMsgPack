<Project Sdk="Microsoft.NET.Sdk">

  <!-- The speed of LsMsgPack under NativeAOT, with and without the source generator, against the JIT (run.sh): the invoices of the benchmarks, System.Text.Json (source generated) as the baseline.
       The model is kept by Model.xml for the serializers without a context (reflection). Not in LsMsgPack.slnf: publishing needs clang (or gcc). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Configurations>Debug;Release;DebugKeepTrack;ReleaseKeepTrack</Configurations>
    <Nullable>disable</Nullable>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <TrimmerRootDescriptor Include="Model.xml" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LsMsgPack\LsMsgPack.csproj" />
    <ProjectReference Include="..\LsMsgPack.Generator\LsMsgPack.Generator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <Import Project="..\LsMsgPackCore\buildTransitive\LsMsgPack.Core.props" />
  <Import Project="..\LsMsgPack\buildTransitive\LsMsgPack.props" />

</Project>
