<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="..\Packaging.props" />

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Configurations>Debug;Release;DebugKeepTrack;ReleaseKeepTrack</Configurations>
    <Nullable>disable</Nullable>
    <RootNamespace>LsMsgPackMcp</RootNamespace>
    <AssemblyName>LsMsgPackMcp</AssemblyName>
    <Description>MsgPack for AI agents: an MCP server (stdio) and command line tool that decode MsgPack data (LsMsgPack's indexed schema, type ids, extensions) into text an AI can read, and that read the bytes of variables of a program paused in the debugger of VS Code or Visual Studio (through the MsgPack Explorer extensions).</Description>
    <!-- Framework-dependent and portable: runs with the user's dotnet on any OS (also as a .NET tool) -->
    <SelfContained>false</SelfContained>
    <UseAppHost>false</UseAppHost>
    <RollForward>Major</RollForward>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>lsmsgpack-mcp</ToolCommandName>
    <PackageId>LsMsgPack.Mcp</PackageId>
    <Title>LsMsgPack MCP server</Title>
    <PackageTags>msgpack;messagepack;mcp;debugger;ai</PackageTags>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='ReleaseKeepTrack|AnyCPU'">
    <Optimize>True</Optimize>
  </PropertyGroup>

  <!-- An MCP server package: nuget.org shows the configuration from .mcp/server.json, and the MCP registry (VS Code's @mcp gallery)
       refers to the package. server.json is what mcp-publisher sends to the registry (Publish-LsMsgPack.cmd sets its version), the
       package gets a copy with the version of the package. -->
  <Target Name="PackMcpServerJson" BeforeTargets="_GetPackageFiles">
    <PropertyGroup>
      <!-- Here, not in the project: PackAsTool sets DotnetTool after the project is read (SDK 8 and 9) -->
      <PackageType>DotnetTool;McpServer</PackageType>
      <_McpServerJson>$([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)/server.json'))</_McpServerJson>
      <_McpServerJson>$([System.Text.RegularExpressions.Regex]::Replace($(_McpServerJson), '(&quot;version&quot;\s*:\s*&quot;)[^&quot;]*', '${1}$(Version)'))</_McpServerJson>
      <_McpServerJsonPath>$(IntermediateOutputPath)mcp/server.json</_McpServerJsonPath>
    </PropertyGroup>
    <WriteLinesToFile File="$(_McpServerJsonPath)" Lines="$(_McpServerJson.TrimEnd())" Overwrite="true" WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <None Include="$(_McpServerJsonPath)" Pack="true" PackagePath=".mcp/" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <InternalsVisibleTo Include="LsMsgPackMcpServerTests" />
  </ItemGroup>

  <!-- The KeepTrack build of the library: the one of this build when it is one (the solution builds it in the same run; Visual Studio does not build references,
       so another configuration would be whatever is in its bin folder), otherwise ReleaseKeepTrack -->
  <PropertyGroup>
    <KeepTrackConfiguration>ReleaseKeepTrack</KeepTrackConfiguration>
    <KeepTrackConfiguration Condition="$(Configuration.EndsWith('KeepTrack'))">$(Configuration)</KeepTrackConfiguration>
  </PropertyGroup>

  <!-- Offsets, MpError items and validation only exist in the KeepTrack builds of the library: as LsMsgPackInspector, whatever configuration this project is built in -->
  <ItemGroup>
    <ProjectReference Include="..\ObjectDebugger\ObjectDebugger.csproj" AdditionalProperties="Configuration=$(KeepTrackConfiguration)" GlobalPropertiesToRemove="CurrentSolutionConfigurationContents;BuildingSolutionFile" />
    <ProjectReference Include="..\LsMsgPackNetStandard\LsMsgPack.csproj" AdditionalProperties="Configuration=$(KeepTrackConfiguration)" GlobalPropertiesToRemove="CurrentSolutionConfigurationContents;BuildingSolutionFile" />
    <ProjectReference Include="..\LsMsgPackCore\LsMsgPack.Core.csproj" AdditionalProperties="Configuration=$(KeepTrackConfiguration)" GlobalPropertiesToRemove="CurrentSolutionConfigurationContents;BuildingSolutionFile" />
  </ItemGroup>

</Project>
