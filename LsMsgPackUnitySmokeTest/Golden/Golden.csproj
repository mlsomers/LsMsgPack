<Project Sdk="Microsoft.NET.Sdk">
  <!-- Writes the expected bytes and values (.NET 10, LsMsgPack's net8.0 build) for the Unity players: golden.txt -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../Project/Assets/Scripts/SmokeModel.cs" Link="SmokeModel.cs" />
    <Compile Include="../Project/Assets/Scripts/SmokeChecks.cs" Link="SmokeChecks.cs" />
    <ProjectReference Include="../../LsMsgPack/LsMsgPack.csproj" />
    <ProjectReference Include="../../LsMsgPackDebug/LsMsgPackDebug.csproj" />
  </ItemGroup>
</Project>
