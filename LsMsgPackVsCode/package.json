{
  "name": "lsmsgpack-explorer",
  "displayName": "MsgPack Explorer (LsMsgPack)",
  "description": "Inspect MsgPack data while debugging (byte[], Stream, List<byte>, Memory<byte>, HttpContent...) and in .msgpack files: item tree, hex view, properties, validation, objects with the indexed schema of LsMsgPack. Lets AI agents (MCP) read and decode MsgPack while debugging.",
  "version": "2026.10.6",
  "publisher": "mlsomers",
  "license": "Apache-2.0",
  "icon": "media/icon.png",
  "homepage": "https://github.com/mlsomers/LsMsgPack",
  "repository": {
    "type": "git",
    "url": "https://github.com/mlsomers/LsMsgPack.git",
    "directory": "LsMsgPackVsCode"
  },
  "bugs": {
    "url": "https://github.com/mlsomers/LsMsgPack/issues"
  },
  "keywords": [
    "msgpack",
    "messagepack",
    "debugger",
    "visualizer",
    "hex",
    "mcp",
    "ai"
  ],
  "categories": [
    "Debuggers",
    "Visualization",
    "Other"
  ],
  "engines": {
    "vscode": "^1.90.0"
  },
  "main": "./out/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "lsmsgpack.viewVariable",
        "title": "View as MsgPack",
        "category": "MsgPack"
      },
      {
        "command": "lsmsgpack.inspectExpression",
        "title": "Inspect Expression...",
        "category": "MsgPack"
      },
      {
        "command": "lsmsgpack.openFile",
        "title": "Open File...",
        "category": "MsgPack"
      },
      {
        "command": "lsmsgpack.fromClipboard",
        "title": "Explore Bytes from Clipboard",
        "category": "MsgPack"
      },
      {
        "command": "lsmsgpack.fromSelection",
        "title": "Explore Selected Text as MsgPack",
        "category": "MsgPack"
      },
      {
        "command": "lsmsgpack.copyMcpConfiguration",
        "title": "Copy MCP Server Configuration...",
        "category": "MsgPack"
      }
    ],
    "menus": {
      "debug/variables/context": [
        {
          "command": "lsmsgpack.viewVariable",
          "group": "navigation@100"
        }
      ],
      "editor/context": [
        {
          "command": "lsmsgpack.fromSelection",
          "when": "editorHasSelection",
          "group": "9_cutcopypaste@100"
        }
      ],
      "commandPalette": [
        {
          "command": "lsmsgpack.viewVariable",
          "when": "false"
        },
        {
          "command": "lsmsgpack.inspectExpression",
          "when": "inDebugMode"
        },
        {
          "command": "lsmsgpack.fromSelection",
          "when": "editorHasSelection"
        }
      ]
    },
    "customEditors": [
      {
        "viewType": "lsmsgpack.explorer",
        "displayName": "MsgPack Explorer",
        "selector": [
          {
            "filenamePattern": "*.msgpack"
          },
          {
            "filenamePattern": "*.MsgPack"
          },
          {
            "filenamePattern": "*.mpk"
          }
        ],
        "priority": "default"
      }
    ],
    "configuration": {
      "title": "MsgPack Explorer",
      "properties": {
        "lsmsgpack.dotnetPath": {
          "type": "string",
          "default": "",
          "markdownDescription": "The `dotnet` executable that runs the inspector (.NET 8 or later). Empty: `dotnet` on the PATH."
        },
        "lsmsgpack.displayLimit": {
          "type": "number",
          "default": 1000,
          "minimum": 0,
          "markdownDescription": "The number of items shown at first (0: no limit). More items take longer to show."
        },
        "lsmsgpack.maxBytes": {
          "type": "number",
          "default": 16777216,
          "minimum": 1,
          "markdownDescription": "The most bytes read from the debugged program. Larger values are read up to this length."
        },
        "lsmsgpack.chunkSize": {
          "type": "number",
          "default": 49152,
          "minimum": 3,
          "markdownDescription": "The bytes read per evaluation in the debugger (as base64). Smaller chunks are used when the debugger shortens long strings."
        },
        "lsmsgpack.mcp.enabled": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Lets AI agents read MsgPack bytes from the debugger through the MCP server of this extension (the chat agent mode of VS Code, and MCP servers started by other clients such as Claude Code, found through a lock file in `~/.lsmsgpack/ide`). The server listens on 127.0.0.1 and requires a random token."
        },
        "lsmsgpack.mcp.allowAnyExpression": {
          "type": "boolean",
          "default": false,
          "scope": "application",
          "markdownDescription": "Lets AI agents read any expression, including method calls that can change the debugged program. Off: only variable and member paths (e.g. `buffer`, `this._payload`, `items[2].Data`). User settings only, a workspace cannot turn it on."
        }
      }
    },
    "mcpServerDefinitionProviders": [
      {
        "id": "lsmsgpack.mcp",
        "label": "MsgPack (LsMsgPack)"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "build:server": "dotnet publish Server/LsMsgPackInspector.csproj -c Release -o dist/inspector --nologo -p:DebugType=none -p:DebugSymbols=false",
    "build:mcp": "dotnet publish ../LsMsgPackMcpServer/LsMsgPackMcpServer.csproj -c Release -o dist/mcp --nologo -p:DebugType=none -p:DebugSymbols=false",
    "test": "npm run compile && node --test test/*.test.js",
    "vscode:prepublish": "npm run build:server && npm run build:mcp && npm run compile",
    "package": "vsce package --baseContentUrl https://github.com/mlsomers/LsMsgPack/blob/HEAD/LsMsgPackVsCode --baseImagesUrl https://github.com/mlsomers/LsMsgPack/raw/HEAD/LsMsgPackVsCode"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "~1.90.0",
    "@vscode/vsce": "^3.0.0",
    "typescript": "^5.6.0"
  }
}
