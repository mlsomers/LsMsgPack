<Project Sdk="Microsoft.NET.Sdk">

  <!-- The analyzers of LsMsgPack and LtMsgPack (see docs/Analyzers.md): runs inside the compiler, netstandard2.0, packed into the LsMsgPack.Core package (analyzers/dotnet/cs) by LsMsgPack.Core.csproj, not a package of its own.
       The code fixes are in LsMsgPack.Analyzers.CodeFixes: they need the Workspaces of the IDE, which the command line compiler does not load. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <Configurations>Debug;Release;DebugKeepTrack;ReleaseKeepTrack</Configurations>
    <LangVersion>12</LangVersion>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
    <IsRoslynComponent>true</IsRoslynComponent>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <RootNamespace>LsMsgPack.Analyzers</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\CommonAssemblyInfo.cs" Link="Properties\CommonAssemblyInfo.cs" />
    <AdditionalFiles Include="AnalyzerReleases.Shipped.md" />
    <AdditionalFiles Include="AnalyzerReleases.Unshipped.md" />
  </ItemGroup>

  <ItemGroup>
    <!-- 4.8: the compiler of the .NET 8 SDK and Visual Studio 17.8, as the source generator -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.8.0" PrivateAssets="all" />
  </ItemGroup>

</Project>
