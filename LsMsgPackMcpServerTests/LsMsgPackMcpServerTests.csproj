<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Library</OutputType>
    <Configurations>Debug;Release;DebugKeepTrack;ReleaseKeepTrack</Configurations>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="MSTest.TestAdapter" Version="4.5.2" />
    <PackageReference Include="MSTest.TestFramework" Version="4.5.2" />
  </ItemGroup>

  <!-- The KeepTrack build of the library: the one of this build when it is one (the solution builds it in the same run; Visual Studio does not build references,
       so another configuration would be whatever is in its bin folder), otherwise ReleaseKeepTrack -->
  <PropertyGroup>
    <KeepTrackConfiguration>ReleaseKeepTrack</KeepTrackConfiguration>
    <KeepTrackConfiguration Condition="$(Configuration.EndsWith('KeepTrack'))">$(Configuration)</KeepTrackConfiguration>
  </PropertyGroup>

  <!-- The library in its KeepTrack build, as the server uses it (one LsMsgPackDebug.dll in the output) -->
  <ItemGroup>
    <ProjectReference Include="..\LsMsgPackMcpServer\LsMsgPackMcpServer.csproj" />
    <ProjectReference Include="..\ObjectDebugger\ObjectDebugger.csproj" AdditionalProperties="Configuration=$(KeepTrackConfiguration)" GlobalPropertiesToRemove="CurrentSolutionConfigurationContents;BuildingSolutionFile" />
    <ProjectReference Include="..\LsMsgPackDebug\LsMsgPackDebug.csproj" AdditionalProperties="Configuration=$(KeepTrackConfiguration)" GlobalPropertiesToRemove="CurrentSolutionConfigurationContents;BuildingSolutionFile" />
    <ProjectReference Include="..\LsMsgPackCore\LsMsgPack.Core.csproj" AdditionalProperties="Configuration=$(KeepTrackConfiguration)" GlobalPropertiesToRemove="CurrentSolutionConfigurationContents;BuildingSolutionFile" />
    <!-- Writes the streams the tests decode (MsgPackStreamWriter) -->
    <ProjectReference Include="..\LsMsgPack\LsMsgPack.csproj" AdditionalProperties="Configuration=$(KeepTrackConfiguration)" GlobalPropertiesToRemove="CurrentSolutionConfigurationContents;BuildingSolutionFile" />
  </ItemGroup>

</Project>
