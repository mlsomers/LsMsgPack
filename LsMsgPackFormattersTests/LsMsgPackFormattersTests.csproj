<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Library</OutputType>
    <IsPackable>false</IsPackable>
    <Configurations>Debug;Release;DebugKeepTrack;ReleaseKeepTrack</Configurations>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.TestHost" Version="10.0.14" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="NUnit" Version="4.6.1" />
    <PackageReference Include="NUnit3TestAdapter" Version="6.3.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LsMsgPackFormatters\LsMsgPackFormatters.csproj" />
    <!-- LsMsgPack checks that what the formatters (LsMsgPack) write is what LsMsgPack writes and reads. LsMsgPack comes with the formatter.
         No configuration mapping: Visual Studio does not build references, so a mapped configuration that the solution build does not produce compiles against an old build (CLAUDE.md) -->
    <ProjectReference Include="..\LsMsgPackDebug\LsMsgPackDebug.csproj" />
  </ItemGroup>

</Project>
