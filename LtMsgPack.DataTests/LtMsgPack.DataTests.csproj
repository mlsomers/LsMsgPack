<Project Sdk="Microsoft.NET.Sdk">

  <!-- LtMsgPack.Data (rows of a data reader as MsgPack, streams of result sets and table dumps, dumps as a data reader, rows into objects): the bytes against the serializer, and the benchmark against Dapper -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <OutputType>Library</OutputType>
    <Configurations>Debug;Release;DebugKeepTrack;ReleaseKeepTrack</Configurations>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageReference Include="MSTest.TestAdapter" Version="4.4.1" />
    <PackageReference Include="MSTest.TestFramework" Version="4.4.1" />
    <PackageReference Include="Dapper" Version="2.1.66" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.32" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LsMsgPackNetStandard\LsMsgPack.csproj" />
    <ProjectReference Include="..\LtMsgPack.Data\LtMsgPack.Data.csproj" />
  </ItemGroup>

</Project>
