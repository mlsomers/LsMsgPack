<Project Sdk="Microsoft.NET.Sdk">

  <!-- NativeAOT smoke test of LtMsgPack with its source generator (run.sh): a JIT run writes the expected bytes and values (golden.txt, from the runtime plans),
       the NativeAOT build reads the same data with the generated code. Not in LsMsgPack.slnf: publishing needs clang (and zlib1g-dev). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Configurations>Debug;Release;DebugKeepTrack;ReleaseKeepTrack</Configurations>
    <Nullable>disable</Nullable>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\LtMsgPack\LtMsgPack.csproj" />
    <ProjectReference Include="..\LtMsgPack.Generator\LtMsgPack.Generator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <Import Project="..\LtMsgPack\buildTransitive\LtMsgPack.props" />

</Project>
