<Project Sdk="Microsoft.NET.Sdk">

  <!-- Tests of LsMsgPack's source generator: its output (snapshots), that the output compiles (C# 7.3 against .NET Standard 2.0, and C# latest), diagnostics and options -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Library</OutputType>
    <Configurations>Debug;Release;DebugKeepTrack;ReleaseKeepTrack</Configurations>
    <Nullable>disable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageReference Include="MSTest.TestAdapter" Version="4.5.3" />
    <PackageReference Include="MSTest.TestFramework" Version="4.5.3" />
    <!-- newer than the generator's 4.8: a newer compiler loads the generator, as in a newer SDK -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.12.0" />
    <!-- compiles VB models: the fields VB generates, as C# projects referencing them see them -->
    <PackageReference Include="Microsoft.CodeAnalysis.VisualBasic" Version="5.12.0" />
    <PackageReference Include="Basic.Reference.Assemblies.NetStandard20" Version="1.8.15" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LsMsgPackCore\LsMsgPack.Core.csproj" />
    <ProjectReference Include="..\LsMsgPack.Generator\LsMsgPack.Generator.csproj" />
    <ProjectReference Include="..\LsMsgPack\LsMsgPack.csproj" />
    <!-- The .NET Standard 2.0 build of LsMsgPack (and so of LsMsgPack.Core): the generated code is compiled against it as C# 7.3, as in a .NET Framework project -->
    <ProjectReference Include="..\LsMsgPack\LsMsgPack.csproj" SetTargetFramework="TargetFramework=netstandard2.0" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>LsMsgPackNetStandard20</_Parameter1>
      <_Parameter2>$(MSBuildThisFileDirectory)..\LsMsgPack\bin\$(Configuration)\netstandard2.0\</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>FixtureDirectory</_Parameter1>
      <_Parameter2>$(MSBuildThisFileDirectory)Fixtures\</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>SnapshotDirectory</_Parameter1>
      <_Parameter2>$(MSBuildThisFileDirectory)Snapshots\</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
