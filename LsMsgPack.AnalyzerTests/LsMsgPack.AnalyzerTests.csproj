<Project Sdk="Microsoft.NET.Sdk">

  <!-- Tests of LsMsgPack.Analyzers and its code fixes: source text compiled against the libraries (and the ASP.NET Core and HttpClient formatters), the diagnostics and the fixed text -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Library</OutputType>
    <Configurations>Debug;Release;DebugKeepTrack;ReleaseKeepTrack</Configurations>
    <Nullable>disable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageReference Include="MSTest.TestAdapter" Version="4.5.3" />
    <PackageReference Include="MSTest.TestFramework" Version="4.5.3" />
    <!-- newer than the analyzers' 4.8: a newer compiler and IDE load them, as in a newer SDK -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="5.12.0" />
    <!-- compiles VB models: the fields VB generates, as C# projects referencing them see them -->
    <PackageReference Include="Microsoft.CodeAnalysis.VisualBasic" Version="5.12.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LsMsgPack.Analyzers\LsMsgPack.Analyzers.csproj" />
    <ProjectReference Include="..\LsMsgPack.Analyzers.CodeFixes\LsMsgPack.Analyzers.CodeFixes.csproj" />
    <ProjectReference Include="..\LsMsgPackDebug\LsMsgPackDebug.csproj" />
    <ProjectReference Include="..\LsMsgPack\LsMsgPack.csproj" />
    <ProjectReference Include="..\LsMsgPackFormatters\LsMsgPackFormatters.csproj" />
    <ProjectReference Include="..\LsMsgPackWebApiFormatters\LsMsgPackWebApiFormatters.csproj" />
  </ItemGroup>

</Project>
