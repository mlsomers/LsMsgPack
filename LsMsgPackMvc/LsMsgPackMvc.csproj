<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="..\Packaging.props" />

  <PropertyGroup>
    <!-- ASP.NET MVC 5 (System.Web.Mvc) only runs on .NET Framework -->
    <TargetFramework>net462</TargetFramework>
    <Configurations>Debug;Release;DebugKeepTrack;ReleaseKeepTrack</Configurations>
    <PackageId>LsMsgPack.AspNet.Mvc</PackageId>
    <Description>MsgPack model binding (LtMsgPack) and action result for ASP.NET MVC 5 controllers on .NET Framework (application/msgpack, application/x-msgpack and application/x-lsmsgpack).</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNet.Mvc" Version="5.2.9" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Web" />
    <Reference Include="System.Net.Http" />
  </ItemGroup>

  <ItemGroup>
    <!-- In the configuration the solution gives LtMsgPack: LtMsgPack and LsMsgPack.Core have no KEEPTRACK code, so their KeepTrack builds are the same.
         (A mapping to Debug/Release here made Visual Studio compile against an old LtMsgPack: the IDE does not build references, so nothing built that configuration.) -->
    <ProjectReference Include="..\LtMsgPack\LtMsgPack.csproj" />
  </ItemGroup>

</Project>
