<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="..\Packaging.props" />

  <PropertyGroup>
    <!-- ASP.NET MVC 5 (System.Web.Mvc) only runs on .NET Framework -->
    <TargetFramework>net462</TargetFramework>
    <Configurations>Debug;Release;DebugKeepTrack;ReleaseKeepTrack</Configurations>
    <PackageId>LsMsgPack.AspNet.Mvc</PackageId>
    <Description>MsgPack model binding (LtMsgPack) and action result for ASP.NET MVC 5 controllers on .NET Framework (application/msgpack, application/x-msgpack and application/x-lsmsgpack).</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNet.Mvc" Version="5.2.9" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Web" />
    <Reference Include="System.Net.Http" />
  </ItemGroup>

  <ItemGroup>
    <!-- LtMsgPack has no KEEPTRACK, map DebugKeepTrack -> Debug and ReleaseKeepTrack -> Release (as before with LsMsgPack, whose debugging overhead does not belong in a web server) -->
    <ProjectReference Include="..\LtMsgPack\LtMsgPack.csproj" AdditionalProperties="Configuration=$(Configuration.Replace('KeepTrack', ''))" />
  </ItemGroup>

</Project>
