<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="..\Packaging.props" />

  <PropertyGroup>
    <!-- ASP.NET MVC 5 (System.Web.Mvc) only runs on .NET Framework -->
    <TargetFramework>net462</TargetFramework>
    <Configurations>Debug;Release;DebugKeepTrack;ReleaseKeepTrack</Configurations>
    <PackageId>LsMsgPack.AspNet.Mvc</PackageId>
    <Description>MessagePack (MsgPack) model binding and action result for ASP.NET MVC 5 controllers on .NET Framework, on the fast LsMsgPack serializer (application/msgpack, application/x-msgpack and application/x-lsmsgpack).</Description>
    <PackageTags>$(PackageTags);aspnet;mvc;asp.net-mvc;mvc5;modelbinder</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNet.Mvc" Version="5.3.0" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Web" />
    <Reference Include="System.Net.Http" />
  </ItemGroup>

  <ItemGroup>
    <!-- In the configuration the solution gives LsMsgPack: LsMsgPack and LsMsgPack.Core have no KEEPTRACK code, so their KeepTrack builds are the same.
         (A mapping to Debug/Release here made Visual Studio compile against an old LsMsgPack: the IDE does not build references, so nothing built that configuration.) -->
    <!-- PrivateAssets none: the analyzers (LsMsgPack.Core) and LsMsgPack's source generator reach the projects that reference this package -->
    <ProjectReference Include="..\LsMsgPack\LsMsgPack.csproj" PrivateAssets="none" />
  </ItemGroup>

</Project>
