<Project Sdk="Microsoft.NET.Sdk">

  <!-- LsMsgPack.Data (rows of a data reader as MsgPack, streams of result sets and table dumps, dumps as a data reader, rows into objects): the bytes against the serializer, and the benchmark against Dapper -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Library</OutputType>
    <Configurations>Debug;Release;DebugKeepTrack;ReleaseKeepTrack</Configurations>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="MSTest.TestAdapter" Version="4.5.2" />
    <PackageReference Include="MSTest.TestFramework" Version="4.5.2" />
    <PackageReference Include="Dapper" Version="2.1.89" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LsMsgPackDebug\LsMsgPackDebug.csproj" />
    <ProjectReference Include="..\LsMsgPack.Data\LsMsgPack.Data.csproj" />
  </ItemGroup>

</Project>
