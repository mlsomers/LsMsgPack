<Project Sdk="Microsoft.NET.Sdk">

  <!-- The source generator of LtMsgPack (see docs/SourceGenerator.md). Runs inside the compiler: netstandard2.0, packed into the LtMsgPack package (analyzers/dotnet/cs) by LtMsgPack.csproj, not a package of its own. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <Configurations>Debug;Release;DebugKeepTrack;ReleaseKeepTrack</Configurations>
    <!-- The generator is not limited to C# 7.3 (it is not loaded by .NET Framework applications): records for the equatable models of the incremental pipeline -->
    <LangVersion>12</LangVersion>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
    <IsRoslynComponent>true</IsRoslynComponent>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <RootNamespace>LtMsgPack.Generator</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\CommonAssemblyInfo.cs" Link="Properties\CommonAssemblyInfo.cs" />
    <AdditionalFiles Include="AnalyzerReleases.Shipped.md" />
    <AdditionalFiles Include="AnalyzerReleases.Unshipped.md" />
  </ItemGroup>

  <ItemGroup>
    <!-- 4.8: the compiler of the .NET 8 SDK and Visual Studio 17.8, the oldest that loads the generator -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.8.0" PrivateAssets="all" />
  </ItemGroup>

</Project>
