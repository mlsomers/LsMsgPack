<Project Sdk="Microsoft.NET.Sdk">

  <!-- NativeAOT without the source generator (run by ../LsMsgPackAotSmokeTest/run.sh): the smoke test's Program.cs compiled with NO_GENERATOR, its model kept by Model.xml
       (as an application keeps its model for a serializer without a context), checked against the golden.txt of the smoke test's JIT run. Not in LsMsgPack.slnf. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Configurations>Debug;Release;DebugKeepTrack;ReleaseKeepTrack</Configurations>
    <Nullable>disable</Nullable>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <IsPackable>false</IsPackable>
    <DefineConstants>$(DefineConstants);NO_GENERATOR</DefineConstants>
    <RootNamespace>LsMsgPackAotSmokeTest</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\LsMsgPackAotSmokeTest\Program.cs" Link="Program.cs" />
    <!-- The namespace LsMsgPackAotSmokeTest, not LsMsgPackAotSmokeTest.Unkept: a class the application does not keep is refused -->
    <TrimmerRootDescriptor Include="Model.xml" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LsMsgPack\LsMsgPack.csproj" />
    <ProjectReference Include="..\LsMsgPack.SignalR\LsMsgPack.SignalR.csproj" />
  </ItemGroup>

</Project>
