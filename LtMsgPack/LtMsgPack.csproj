<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="..\Packaging.props" />

  <PropertyGroup>
    <!-- 2.1 can ask whether the runtime supports dynamic code (RuntimeFeature.IsDynamicCodeSupported, see PropertyAccessor), net8.0 runs the trim and AOT analyzers -->
    <TargetFrameworks>netstandard2.0;netstandard2.1;net8.0</TargetFrameworks>
    <Configurations>Debug;Release;DebugKeepTrack;ReleaseKeepTrack</Configurations>
    <Nullable>disable</Nullable>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <RootNamespace>LtMsgPack</RootNamespace>
    <PackageId>LtMsgPack</PackageId>
    <Description>Fast MessagePack (MsgPack) serializer for .NET classes, used like the JSON serializers: 3-5x as fast as System.Text.Json with 35-47% smaller payloads. Polymorphism with type ids, an optional indexed schema, data of older and newer class versions still loads, streaming, presets for MessagePack-CSharp and Nerdbank.MessagePack, and a source generator for NativeAOT and trimming.</Description>
    <PackageTags>$(PackageTags);binary-serialization;high-performance;polymorphism;schema;streaming;source-generator;aot</PackageTags>
  </PropertyGroup>

  <!-- Trimmed and NativeAOT apps get warnings where their use of the library is unsafe (the analyzers only run for .NET targets; the .NET Standard builds have the same annotations, polyfilled in Core) -->
  <PropertyGroup Condition="'$(TargetFramework)'=='net8.0'">
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)'=='ReleaseKeepTrack'">
    <Optimize>True</Optimize>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)'!='net8.0'">
    <PackageReference Include="System.Memory" Version="4.6.3" />
    <PackageReference Include="System.Runtime.CompilerServices.Unsafe" Version="6.1.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- PrivateAssets none: the analyzers of LsMsgPack.Core reach the projects that reference this package (NuGet leaves out the analyzers of dependencies otherwise) -->
    <ProjectReference Include="..\LsMsgPackCore\LsMsgPack.Core.csproj" PrivateAssets="none" />
  </ItemGroup>

  <!-- The source generator ships in this package (analyzers/dotnet/cs), so the generator and the runtime always have the same version, with the MSBuild properties it reads -->
  <ItemGroup>
    <ProjectReference Include="..\LtMsgPack.Generator\LtMsgPack.Generator.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
    <None Include="..\LtMsgPack.Generator\bin\$(Configuration)\netstandard2.0\LtMsgPack.Generator.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
    <None Remove="buildTransitive\LtMsgPack.props" />
    <None Include="buildTransitive\LtMsgPack.props" Pack="true" PackagePath="buildTransitive;build" />
  </ItemGroup>

</Project>
