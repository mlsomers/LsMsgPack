<Project Sdk="Microsoft.NET.Sdk">

  <!-- Checks what other MsgPack libraries can read of LsMsgPack's output and the other way around (see MessagePackCSharpTests.cs and NerdbankTests.cs, the settings are described in docs/Compatibility.md) -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Library</OutputType>
    <Configurations>Debug;Release;DebugKeepTrack;ReleaseKeepTrack</Configurations>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MessagePack" Version="3.1.12" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageReference Include="MSTest.TestAdapter" Version="4.5.3" />
    <PackageReference Include="MSTest.TestFramework" Version="4.5.3" />
    <PackageReference Include="Nerdbank.MessagePack" Version="1.4.104" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LsMsgPackDebug\LsMsgPackDebug.csproj" />
    <ProjectReference Include="..\LsMsgPack\LsMsgPack.csproj" />
    <!-- LsMsgPack's source generator: TestMsgPackContext (GeneratedContext.cs) for the Gen* tests of the linked SerializerUnderTest.cs -->
    <ProjectReference Include="..\LsMsgPack.Generator\LsMsgPack.Generator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <!-- The tests run against LsMsgPack and LsMsgPack through the same adapters as the unit tests -->
    <Compile Include="..\LsMsgPackUnitTests\SerializerUnderTest.cs" Link="SerializerUnderTest.cs" />
  </ItemGroup>

  <Import Project="..\LsMsgPack\buildTransitive\LsMsgPack.props" />

</Project>
