<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- Serves payloads of the ASP.NET Core formatters to the tests of the TypeScript client (clients/typescript/test/server.test.mjs), and System.Text.Json of the same values as the expected objects -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <Configurations>Debug;Release;DebugKeepTrack;ReleaseKeepTrack</Configurations>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\LsMsgPackFormatters\LsMsgPackFormatters.csproj" />
  </ItemGroup>

</Project>
